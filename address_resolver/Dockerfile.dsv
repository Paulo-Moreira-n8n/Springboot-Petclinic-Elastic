# Recriação do índice + carga de dados

Abra um Git Bash em C:\GIT\Springboot-Petclinic-Elastic\address_resolver

# 1. Apague o índice atual
# curl -u elastic:changeme -X DELETE 'http://localhost:9200/address'

 2. Crie o índice com o novo mapping:
 curl -u elastic:changeme -H 'Content-Type: application/json' \
   -X PUT 'http://localhost:9200/address' \
   -d @src/mapping.json

 3. Recarregue o CSV:
 python src/data_load.py \
   --file address.csv \
   --index address \
   --es_host localhost:9200 \
   --es_user elastic \
   --es_password changeme

# 4. Force refresh (o script já chama refresh, mas pode validar):
# curl -u elastic:changeme -X POST 'http://localhost:9200/address/_refresh'

# 5. Verifique o mapeamento dos campos
# curl -u elastic:changeme 'http://localhost:9200/address/_mapping?pretty'

# 6. Verifique se há docs com o ZIP 29127
 curl -u elastic:changeme -H 'Content-Type: application/json' \
   -X GET 'http://localhost:9200/address/_search?pretty' \
   -d '{
     "query": { "term": { "zip_code": { "value": "29127" } } }
   }'

# 6. Verifique se há docs com o ZIP 29127 pela api dos address_resolver
curl -i -X POST http://localhost:5000/api/find_state \
  -H 'Content-Type: application/json' \
  -d '{ "zip_code": "29127" }'

# 7. Verifique se há city com o ZIP 29127 pela api dos address_resolver
curl -sS -X POST http://localhost:5000/api/find_city \
  -H 'Content-Type: application/json' \
  -d '{"zip_code":"29127"}'
  
  # 7. Verifique se há state com o ZIP 29127 pela api dos address_resolver
curl -sS -X POST http://localhost:5000/api/find_state \
  -H 'Content-Type: application/json' \
  -d '{"zip_code":"29127"}'


