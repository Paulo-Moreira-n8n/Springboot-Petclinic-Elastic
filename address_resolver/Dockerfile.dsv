# Para entrar em um conteiner ambientado para a aplicação
# docker run -it --rm -p 5000:5000 --name spring-address-finder -v "$(pwd):/app" -w /app python:3.6-stretch sh
# --network petclinic-stack_spring-petclinic-net


# ==== BUILD STAGE (recomendado para produção) ====

FROM python:3.6-stretch

ENV PYTHONHTTPSVERIFY=0 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/root \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app/src

COPY /src . 

# RUN cp gunicorn.conf gunicorn.conf.py

RUN pip install \
    --trusted-host pypi.org \
    --trusted-host pypi.python.org \
    --trusted-host files.pythonhosted.org \
    gunicorn json-logging-py

RUN pip install \
    --trusted-host pypi.org \
    --trusted-host pypi.python.org \
    --trusted-host files.pythonhosted.org \
	--no-cache-dir -r requirements.txt

EXPOSE 5000

# Empacota a aplicação
WORKDIR /app
RUN tar -czf spring-address-finder.tar.gz src/.

WORKDIR /app/src
ENTRYPOINT ["/usr/local/bin/gunicorn", "--config", "gunicorn.conf", "--log-config", "logging.conf", "-b", ":5000", "server:app"]


# /usr/local/bin/gunicorn --config gunicorn.conf.py --log-config logging.conf -b :5000 server:app
